[TEMPLATE]
# ---------------------------------------------------------------------------
# GrowSpace API environment
# Server-side only. Never expose these values to the browser bundle.
# Local development: copy to apps/api/.env.local. Production: set them in the
# hosting provider's server-side environment.
# ---------------------------------------------------------------------------

# Required. Neon PostgreSQL connection string. Use the pooled ("-pooler") host
# for the API runtime; use the direct/unpooled host for scripts/run-migration.mjs.
DATABASE_URL=postgresql://user:password@your-project-pooler.region.aws.neon.tech/database?sslmode=require

# Required in production. Comma-separated bare browser origins allowed to call the
# API (CORS + CSRF Origin validation). No trailing slash, no path. Production
# fails closed (503) when this is missing or malformed. Example shape:
#   ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
ALLOWED_ORIGINS=http://localhost:5173

# Required in production. Canonical SPA origin used in verification and password
# reset links. Must be an exact https:// origin.
# APP_ORIGIN=https://app.example.com

# Required for login, registration, and password reset. HMAC secret of at least
# 32 characters for database-backed auth rate limiting.
# RATE_LIMIT_SECRET=your-secure-random-32-character-secret-string

# Required for real email delivery (verification + password reset). Without it the
# API uses an in-memory mock mailer: registration succeeds but no email is sent.
# EMAIL_PROVIDER_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=GrowSpace <noreply@example.com>

# Optional. Set to "true" only when running behind a trusted reverse proxy so
# client IPs are read from X-Forwarded-For for IP rate limiting.
# TRUST_PROXY=true

# Hosting platforms usually assign the listening port. `pnpm start` honors PORT
# and defaults to 3001 when it is not set.
# PORT=3001

# ---------------------------------------------------------------------------
# Optional AI providers. Missing credentials degrade AI features only; the API
# and /api/health remain available.
# ---------------------------------------------------------------------------

# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# TAVILY_API_KEY=tvly-your_tavily_api_key_here
# BRAVE_SEARCH_API_KEY=BSA_your_brave_api_key_here
# SEARCH_PROVIDER=tavily

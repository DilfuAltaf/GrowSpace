[TEMPLATE]
# Public build-time variable: this value is embedded in the browser bundle.
# Leave empty when the SPA and API share one origin (recommended): requests go to
# relative /api paths and the session/CSRF cookies are first-party.
#
# For the supported split-subdomain topology, set the exact API origin, e.g.
#   VITE_API_BASE_URL=https://api.example.com
# Changing this value requires rebuilding the web app.
VITE_API_BASE_URL=

# Dev-only proxy target for the Next.js API (ignored in production builds).
VITE_API_PROXY_TARGET=http://localhost:3001
